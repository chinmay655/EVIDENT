import { Link } from "react-router-dom";
import { Clock, Layers, ArrowRight } from "lucide-react";

export function ProjectCard({ project, testId }) {
  const fmtPrice = (p, c) => `${c === "INR" ? "₹" : ""}${p}`;
  return (
    <Link
      to={`/projects/${project.slug}`}
      data-testid={testId || `project-card-${project.slug}`}
      className="group flex flex-col overflow-hidden rounded-lg border border-zinc-200 bg-white transition-colors hover:border-slate-300"
    >
      <div className="relative aspect-[16/9] overflow-hidden bg-slate-100">
        {project.thumbnail && (
          <img src={project.thumbnail} alt={project.title} className="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
        )}
        {project.featured && (
          <span className="absolute left-3 top-3 rounded-full bg-slate-900 px-2.5 py-0.5 text-xs font-medium text-white">Featured</span>
        )}
      </div>
      <div className="flex flex-1 flex-col p-5">
        <div className="flex items-center gap-2 text-xs font-medium text-slate-500">
          <span className="rounded-full bg-slate-50 border border-zinc-200 px-2 py-0.5">{project.category}</span>
          <span>{project.difficulty}</span>
        </div>
        <h3 className="mt-3 text-lg font-semibold leading-snug text-slate-900 group-hover:text-blue-700">{project.title}</h3>
        <p className="mt-2 line-clamp-2 flex-1 text-sm text-slate-500">{project.short_description}</p>
        <div className="mt-4 flex flex-wrap gap-1.5">
          {(project.technologies || []).slice(0, 4).map((t) => (
            <span key={t} className="rounded bg-slate-50 px-2 py-0.5 text-xs text-slate-600 border border-zinc-100">{t}</span>
          ))}
        </div>
        <div className="mt-5 flex items-center justify-between border-t border-zinc-100 pt-4">
          <div className="flex items-center gap-3 text-xs text-slate-500">
            <span className="flex items-center gap-1"><Clock className="h-3.5 w-3.5" /> {project.duration_days}d</span>
            {project.estimated_hours && <span className="flex items-center gap-1"><Layers className="h-3.5 w-3.5" /> {project.estimated_hours}h</span>}
          </div>
          <span className="flex items-center gap-1 text-sm font-semibold text-slate-900">
            {fmtPrice(project.price, project.currency)}
            <ArrowRight className="h-4 w-4 text-blue-600 transition-transform group-hover:translate-x-0.5" />
          </span>
        </div>
      </div>
    </Link>
  );
}
